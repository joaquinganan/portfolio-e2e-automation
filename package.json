{
  "name": "portfolio-e2e-automation",
  "version": "1.0.0",
  "description": "End-to-end Playwright test automation for joaquinganan.dev",
  "scripts": {
    "test:local": "cross-env TEST_ENV=local playwright test --grep @smoke",
    "test:local:full": "cross-env TEST_ENV=local playwright test",

    "test:prod": "cross-env TEST_ENV=prod BASE_URL=https://joaquinganan.dev playwright test",
    "test:prod:smoke": "cross-env TEST_ENV=prod BASE_URL=https://joaquinganan.dev playwright test --grep @smoke",
    "test:prod:regression": "cross-env TEST_ENV=prod BASE_URL=https://joaquinganan.dev playwright test --grep @regression",
    "test:prod:responsive": "cross-env TEST_ENV=prod BASE_URL=https://joaquinganan.dev playwright test tests/responsive.spec.js",
    "test:prod:list": "cross-env TEST_ENV=prod BASE_URL=https://joaquinganan.dev playwright test --list",

    "test:ui": "cross-env TEST_ENV=local playwright test --ui",
    "report": "playwright show-report"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joaquinganan/portfolio-e2e-automation.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/joaquinganan/portfolio-e2e-automation/issues"
  },
  "homepage": "https://github.com/joaquinganan/portfolio-e2e-automation#readme",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2"
  }
}